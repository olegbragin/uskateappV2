<?xml version="1.0" encoding="UTF-8"?>
<VariablesViewState
   version = "1.0">
   <ContextStates>
      <ContextState
         contextName = "WatchConnectivityProvider.send(message:):WatchConnectivityProvider.swift">
         <PersistentStrings>
            <PersistentString
               value = "session.isWatchAppInstalled">
            </PersistentString>
            <PersistentString
               value = "session.isPaired">
            </PersistentString>
            <PersistentString
               value = "session.activationState">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "USCalendarViewModel.handleMagnify(magnification:):USCalendar.swift">
         <PersistentStrings>
            <PersistentString
               value = "-sensitivity">
            </PersistentString>
            <PersistentString
               value = "lastColumnCount">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
   </ContextStates>
</VariablesViewState>
